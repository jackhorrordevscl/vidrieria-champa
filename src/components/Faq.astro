---
import { faqItems } from '../data/faq';
---

<section id="preguntas" class="faq" aria-labelledby="preguntas-title">
  <div class="container faq__grid">
    <div class="faq__titles">
      <p class="eyebrow">05.1 — Preguntas</p>
      <h3 id="preguntas-title" class="faq__title">Lo que más nos preguntan.</h3>
    </div>

    <div class="faq__list">
      {faqItems.map((item, i) => (
        <details class="faq__item" open={i === 0}>
          <summary class="faq__summary">
            <span>{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer">
            {item.answer}
            {item.marker && <> <span class="tag-pending faq__marker">{item.marker}</span></>}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-8) var(--space-9);
  }
  .faq__grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    column-gap: var(--space-8);
    row-gap: var(--space-6);
    align-items: start;
  }
  .faq__titles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .faq__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .faq__list {
    border-top: 1px solid var(--color-border);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 44px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .faq__summary::-webkit-details-marker {
    display: none;
  }
  .faq__summary:hover {
    color: var(--color-accent);
  }
  .faq__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* Decorative +/- drawn with CSS so it is never read by assistive tech */
  .faq__icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: translateY(-50%);
  }
  .faq__icon::after {
    transform: translateY(-50%) rotate(90deg);
    transition: opacity 0.15s ease;
  }
  .faq__item[open] .faq__icon::after {
    opacity: 0;
  }
  .faq__answer {
    max-width: 640px;
    padding-bottom: 22px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .faq__marker {
    font-size: 12px;
    padding: 1px 6px;
  }

  @media (max-width: 960px) {
    .faq {
      padding-block: var(--space-7) var(--space-8);
    }
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
