---
import { whatsappDisplay } from '../config/site';

const rows = ['Qué cubre', 'Por cuánto tiempo', 'Qué no cubre'];
const testimonials = [1, 2];
---

<section id="garantia" class="warranty" aria-labelledby="garantia-title">
  <div class="container">
    <div class="warranty__top">
      <div class="warranty__copy">
        <p class="eyebrow">05 — Garantía</p>
        <h2 id="garantia-title" class="section-title">Trabajo respaldado.</h2>
        <p class="warranty__lead">
          Cada trabajo se entrega con garantía. Aquí explicamos qué cubre, por cuánto tiempo y a quién escribir.
        </p>
      </div>

      <div class="card">
        <p class="card__marker">[GARANTÍA PENDIENTE · DETALLES DEL CLIENTE]</p>
        <dl class="card__rows">
          {rows.map((r) => (
            <div class="card__row">
              <dt>{r}</dt>
              <dd class="card__pending">[POR DEFINIR]</dd>
            </div>
          ))}
          <div class="card__row">
            <dt>Cómo reclamar</dt>
            <dd class="card__pending">WhatsApp {whatsappDisplay}</dd>
          </div>
        </dl>
      </div>
    </div>

    <ul class="warranty__quotes">
      {testimonials.map(() => (
        <li class="quote">
          <p class="quote__marker">[TESTIMONIO PENDIENTE · CON NOMBRE Y AUTORIZACIÓN]</p>
          <p class="quote__text">Espacio reservado para una opinión real de un cliente.</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .warranty {
    padding-block: var(--space-9) var(--space-8);
  }
  .warranty__top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-8);
    row-gap: var(--space-7);
    align-items: start;
  }
  .warranty__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .warranty__lead {
    max-width: 520px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .card {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px dashed var(--color-accent);
    border-radius: 6px;
  }
  .card__marker {
    padding-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
  }
  .card__rows {
    margin: 0;
  }
  .card__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: 14px 0;
    border-top: 1px dashed var(--color-border-strong);
    font-size: 17px;
  }
  .card__row dt {
    color: var(--color-muted);
  }
  .card__row dd {
    margin: 0;
  }
  .card__pending {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
  }
  .warranty__quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-8);
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }
  .quote__marker {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
  }
  .quote__text {
    font-size: 17px;
    line-height: 1.5;
    color: var(--color-dim);
  }

  @media (max-width: 960px) {
    .warranty {
      padding-block: var(--space-8) var(--space-7);
    }
    .warranty__top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .warranty__quotes {
      grid-template-columns: minmax(0, 1fr);
    }
    .card {
      padding: var(--space-5);
    }
  }
</style>
